        "k": 2,
        "s": 12
      }
    },
    {
      "id": "res-o",
      "name": "REACH EFFICIENCY SCORE",
      "short": "REACH_EFFICIENCY_SCORE",
      "format": "numeric",
      "inputs": [
        "sfv",
        "reach",
        "spend"
      ],
      "expression": "reach && spend ? ((sfv / reach) * 100) / (spend / reach) : null",
      "invert": false,
      "enabled": true,
